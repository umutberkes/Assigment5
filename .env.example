# Copy to .env (never commit .env). Every value here is checked by src/config.ts.
APP_ENV=development
PORT=8000
DATABASE_URL=file:./tasks.db
# only for a remote libsql database (Bonus 19)
DATABASE_AUTH_TOKEN=
# Bonus 6: connections in the pool
DB_POOL_SIZE=4
# R3 uses session; Bonus 7 switches to jwt
AUTH_MODE=session
# only for the JWT bonus; production refuses this value
JWT_SECRET=change-me
# Bonus 12
UPLOAD_DIR=./uploads
# Bonus 10
LOG_REQUESTS=true
