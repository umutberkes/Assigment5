{
  "tasks": {
    "dev": "deno run -A --unstable-kv --unstable-cron --env-file=.env --watch src/main.ts",
    "start": "deno run -A --unstable-kv --unstable-cron src/main.ts",
    "start:prod": "deno run -A --unstable-kv --unstable-cron --env-file=.env.production src/main.ts",
    "test": "deno test -A --unstable-kv --unstable-cron",
    "check": "deno check src/*.ts tests/*.ts scripts/*.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "seed": "deno run -A --env-file=.env scripts/seed.ts",
    "explain": "deno run -A scripts/explain.ts",
    "n+1": "deno run -A scripts/n_plus_one.ts",
    "live": "deno run -A scripts/live_client.ts",
    "curl": "sh scripts/curl_examples.sh",
    "db:generate": "deno run -A npm:drizzle-kit@^0.31 generate",
    "db:migrate": "deno run -A npm:drizzle-kit@^0.31 migrate",
    "ui:install": "cd ui && deno install",
    "ui:dev": "cd ui && deno task dev",
    "admin": "deno run -A --env-file=.env scripts/admin.ts",
    "evidence:live": "deno run -A --unstable-kv scripts/verify_live.ts"
  },
  "imports": {
    "hono": "npm:hono@^4",
    "hono/body-limit": "npm:hono@^4/body-limit",
    "hono/http-exception": "npm:hono@^4/http-exception",
    "zod": "npm:zod@^4",
    "bcryptjs": "npm:bcryptjs@^3",
    "drizzle-orm": "npm:drizzle-orm@^0.44",
    "drizzle-orm/libsql": "npm:drizzle-orm@^0.44/libsql",
    "drizzle-orm/libsql/migrator": "npm:drizzle-orm@^0.44/libsql/migrator",
    "drizzle-orm/sqlite-core": "npm:drizzle-orm@^0.44/sqlite-core",
    "drizzle-kit": "npm:drizzle-kit@^0.31",
    "@libsql/client": "npm:@libsql/client@^0.15",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1",
    "jose": "npm:jose@^6",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "fmt": {
    "lineWidth": 90,
    "exclude": [
      "ui/",
      "drizzle/",
      "evidence/"
    ]
  },
  "lint": {
    "exclude": [
      "ui/"
    ]
  }
}
