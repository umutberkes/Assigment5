# Copy to .env.production on the server and fill in real values. Never commit the copy.
APP_ENV=production
PORT=8000
DATABASE_URL=file:/data/tasks.db
DB_POOL_SIZE=4
AUTH_MODE=jwt
# at least 32 random characters, for example: openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL=
UPLOAD_DIR=/data/uploads
LOG_REQUESTS=true
